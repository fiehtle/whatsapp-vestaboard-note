# Create independent values for YOUR deployment; never reuse another service's keys.
# npm run setup:secrets creates .env.local privately and never prints its contents.
ADMIN_TOKEN=
CONFIG_ENCRYPTION_KEY=
CRON_SECRET=

# Connect a NEW PRIVATE Blob store to YOUR Vercel project.
# Vercel provisions BLOB_STORE_ID/OIDC or BLOB_READ_WRITE_TOKEN for that connection.
# Do not manually copy another project's storage credentials.

# Optional for local LIVE evaluations; production normally uses Vercel OIDC.
# AI_GATEWAY_API_KEY=
